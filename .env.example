# =============================================================================
# incoming-check-mvp — environment variables
# Copy this to .env (local) and set the matching keys in Vercel for production.
# Never commit real values — .env is in .gitignore.
# =============================================================================

# --- PostgreSQL (Supabase) ---
# DATABASE_URL points at the Supabase pooled (PgBouncer) connection — used by
# the running app. DIRECT_URL points at the direct (5432) connection — used by
# `prisma migrate` only. Both are shown on Supabase: Project Settings → Database
# → Connection string. Substitute your real password where it says [PASSWORD].
DATABASE_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Generate a long random string, e.g.  openssl rand -hex 32
SESSION_SECRET="replace-this-with-a-long-random-string"

# --- Vercel Blob (file storage) ---
# Create a Blob store: Vercel dashboard → Storage → Create Database → Blob.
# Connect it to this project; the dashboard shows the read/write token.
BLOB_READ_WRITE_TOKEN=""

# --- OpenAI Vision (1688 screenshot parser) ---
# If empty, the system still works — uploads, manual entry, sharing — but the
# "Parse with AI" button returns a friendly error.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# --- Default admin (only used the first time `prisma db seed` runs against an
# empty DB). Once an admin with this email exists, the seed is a no-op and will
# never overwrite the password. ---
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="admin1234"

# --- Optional: public app URL for share-link previews / OG metadata. The
# share-link copy button uses window.location.origin at runtime, so this is
# informational only and does not affect routing. ---
NEXT_PUBLIC_APP_URL=""
